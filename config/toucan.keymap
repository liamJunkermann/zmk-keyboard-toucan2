#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp TAB   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                          &kp LCTRL &kp LALT &lt NAV ENTER   &kp SPACE &lt SYM BSPC &kp LGUI
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans &kp LC(LG(Q)) &kp PSCRN &kp K_APP &none         &none      &kp PG_UP &kp LA(LEFT) &kp UP   &kp LA(RIGHT) &kp RA(BSPC) &kp BSPC
                &trans &kp LALT      &kp LCTRL &kp LSHFT &kp LC(LALT)  &kp CAPS   &kp PG_DN &kp LEFT     &kp DOWN &kp RIGHT     &kp DEL      &kp ENTER
                &trans &kp LG(Z)     &kp LG(X) &kp LG(C) &kp LG(V)     &none      &none     &kp HOME     &none    &kp END       &trans       &trans
                                               &trans    &trans        &trans     &trans    &trans       &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp N1    &kp N2    &kp N3   &kp N4   &kp N5      &kp N6    &kp N7   &kp N8   &kp N9    &kp N0   &trans
                &trans    &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp STAR &kp LPAR  &kp RPAR &kp PIPE
                &trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC &kp RBRC    &kp LBKT  &kp RBKT &kp SEMI &kp COLON &kp BSLH &trans
                                              &trans   &trans   &trans      &trans    &trans   &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp F1     &kp F2         &kp F3       &kp F4       &kp F5       &kp F6          &kp F7 &kp F8       &kp F9     &kp F10      &kp F11 &kp F12
                &bt BT_CLR &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &kp C_BRI_INC   &none  &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &none   &none
                &trans     &studio_unlock &none        &none        &none        &kp C_BRI_DEC   &none  &kp C_PREV   &kp C_PP   &kp C_NEXT   &none   &bootloader
                                                       &trans       &trans       &trans          &trans &trans       &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
